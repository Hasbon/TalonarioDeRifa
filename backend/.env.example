# Database — use PostgreSQL in production/staging
DATABASE_URL=postgresql+psycopg://rifa:rifa_secret@localhost:5432/rifa_digital

# For local quick tests without Docker you may use SQLite:
# DATABASE_URL=sqlite:///./rifa_dev.db

SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PUBLIC_BASE_URL=http://localhost:5173
TIMEZONE=America/Bogota

# Login rate limit
LOGIN_RATE_LIMIT=10/minute
